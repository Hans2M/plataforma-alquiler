# Copiar a .env antes del primer docker compose up
# Cambia los valores marcados CAMBIAR antes de despliegues reales.
POSTGRES_DB=alquiler_db
POSTGRES_USER=alquiler_app
POSTGRES_PASSWORD=CAMBIAR_una_clave_larga_para_la_base
SECRET_KEY=CAMBIAR_clave_aleatoria_para_firmar_tokens_32_caracteres_minimo
ACCESS_TOKEN_MINUTES=60
# Solo orígenes autorizados, separados por comas
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
